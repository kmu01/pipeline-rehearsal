# Only needed if you change the credentials or port in docker-compose.yml.
# The defaults in src/db/client.ts already match the compose file.

# The owner/superuser connection. Used ONLY by `npm run migrate`. Superusers bypass row-level
# security, so nothing else in this program should ever use this one.
DATABASE_URL_ADMIN=postgres://pipeline_admin:pipeline_password@localhost:5432/pipeline

# The restricted application role. Used by everything that touches tenant data. Row-level security
# (migration 002) is enforced against it.
DATABASE_URL=postgres://pipeline_app:pipeline_app_password@localhost:5432/pipeline

# The password `npm run migrate` assigns to pipeline_app. Must match the password in DATABASE_URL
# above. Defaults to pipeline_app_password if not set.
APP_DB_PASSWORD=pipeline_app_password